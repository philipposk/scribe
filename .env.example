# Transcription providers (at least one required)
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Per-app API keys: appId:secret pairs, comma-separated
# Clients send: Authorization: Bearer <secret>
SCRIBE_APP_KEYS=sparks:change-me-sparks,catchy:change-me-catchy

# Comma-separated browser origins allowed for CORS (omit to allow same-origin only)
SCRIBE_CORS_ORIGINS=https://sparks.example.com,https://catchy.example.com

# Optional: persist usage rows (see supabase/scribe_usage.sql)
SCRIBE_SUPABASE_URL=
SCRIBE_SUPABASE_SERVICE_KEY=

# Optional OpenRouter attribution headers
OPENROUTER_HTTP_REFERER=https://scribe.6x7.gr
OPENROUTER_APP_TITLE=Scribe
